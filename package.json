{
  "name": "collector-app",
  "version": "1.0.0",
  "description": "Desktop-Sammlungsverwaltung für Karten, Münzen und mehr",
  "main": "electron/main.js",
  "author": "Christian Demberger",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "android:sync": "npm run build:renderer && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "build": "node scripts/set-api-target.cjs production && npm run build:renderer && electron-builder",
    "pack": "npm run build:renderer && electron-builder --dir",
    "build:local": "node scripts/set-api-target.cjs local && npm run build:renderer && electron-builder && node scripts/set-api-target.cjs production"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "vite": "^8.3.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "adm-zip": "^0.6.1",
    "pdfkit": "^0.20.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "com.itemcase.desktop",
    "productName": "ItemCase",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "allowScripts": {
    "electron@44.4.2": true,
    "esbuild@0.27.4": true
  }
}
