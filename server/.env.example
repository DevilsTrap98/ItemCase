# MySQL connection (mysql:// URL — percent-encode special characters in
# the password, e.g. # -> %23, * -> %2A, ! -> %21, $ -> %24).
MYSQL_URL=mysql://<username>:<password>@<host>:3306/<database-name>

# Server
PORT=5100
NODE_ENV=development
# Origin(s) of the frontend allowed to call this server. Comma-separated
# for multiple; "*" reflects any request origin (fine here — no cookies/
# credentials are used by this API).
CLIENT_ORIGIN=*

# Signs auth JWTs. Generate your own, do not reuse across environments:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<64-char-hex>
