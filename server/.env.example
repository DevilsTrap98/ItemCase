# MySQL URL. Percent-encode special characters in the password.
MYSQL_URL=mysql://user:password@database-host:3306/itemcase

# Server
NODE_ENV=production
PORT=5100
HOST=0.0.0.0
# Generate a secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-bytes

# Comma-separated browser origins. Native Electron requests have no Origin.
CLIENT_ORIGIN=https://app.example.com
# Set to 1 only when exactly one trusted reverse proxy is in front of Node.
TRUST_PROXY=1

# Durable server volume for uploaded images. Back this directory up together
# with MySQL and mount it persistently when deploying with containers.
UPLOADS_DIR=/var/lib/itemcase/uploads
# Public HTTPS origin of this Node server, without /api.
PUBLIC_BASE_URL=https://api.example.com
# SMTP account used for registration verification mails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=itemcase@example.com
SMTP_PASS=replace-with-mailbox-password
EMAIL_FROM=ItemCase <itemcase@example.com>
# Decoded file size limit per image (default: 6 MiB).
MAX_IMAGE_BYTES=6291456
# Comma-separated list of client identifiers /api/* will accept in the
# X-ItemCase-Client header (sent by the desktop app and the mobile/web
# client — see electron/main.js and src/mobile-api.js). NOT a real secret:
# it ships inside the distributed app and only filters generic bots/
# scanners hitting the API with no client at all. Leave unset to disable
# this filter entirely (fails open) — real access control is still the
# JWT auth required on every authenticated route.
CLIENT_APP_SECRET=itemcase-desktop-v1,itemcase-mobile-v1
